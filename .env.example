# ==============================================================================
# ShopEase E-Commerce Store — Environment Configuration Reference
# ==============================================================================
# NOTE: ShopEase works out-of-the-box in Google AI Studio and local development
# using SQLite (db.sqlite3) with automatic CSRF preview origin handling.
# No manual environment variables are required for development.

# Optional Production Overrides (Uncomment and set only when deploying to production):
# SECRET_KEY=replace-with-a-random-50-character-secret-key-in-production
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,*.run.app
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/NAME
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
